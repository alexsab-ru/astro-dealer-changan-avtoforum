---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/site/settings.json';
import PageH1 from '@/ui/page-h1/PageH1.astro';
import Button from '@/ui/button/Button.astro';
import modelsData from '@/data/site/models.json';
import { Icon } from 'astro-icon/components';

const { brand, legal_city_where } = settings;
const { models } = modelsData;

// Список ID моделей для отображения
const modelIds = [
	'cs75plusnew',
	'alsvin',
	'cs35plusnew',
	'cs55plus',
	'cs75plus',
	'cs95',
	'eadoplus',
	'hunterplus',
	'lamore'
];

// Фильтруем модели по ID
const selectedModels = models.filter(model => modelIds.includes(model.id));
---

<Layout title={`Корпоративным клиентам ${brand}`} description={`Информация для корпоративных клиентов - официальный сайт CHANGAN в России.`}>
	<div class="container py-10 space-y-10">
		<div>
			<PageH1 h1={`Корпоративным клиентам ${brand}`} classes="text-3xl sm:text-4xl" />
			<p class="mt-1 text-gray-500">Автомобили CHANGAN — это отличное решение для корпоративных парков любого размера. Широкий модельный ряд и специальные программы позволят подобрать автомобили под любые цели и для любого типа сотрудников: от младшего персонала до высшего руководства и приобрести автомобили на выгодных условиях.</p>
			<Button
				view="popup-link"
				classes="btn mt-4"
				url="#common-modal"
				title="Получить предложение"
				dataTitle="Корпоративным клиентам"
				dataFormName="Корпоративным клиентам. Специальные условия для такси"
			/>
		</div>

		{selectedModels.length > 0 && (
			<div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
					{selectedModels.map((model) => (
						<div class="flex flex-col border rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 bg-white">
							<div class="relative aspect-4/3 flex items-center justify-center bg-gray-50 overflow-hidden lazy p-4 sm:p-6">
								<img
									src="https://cdn.alexsab.ru/loaders/simple-loading-gray.svg"
									data-src={model.thumb}
									alt={`${model.mark_id} ${model.name}`}
									class="opacity-0 w-full h-full object-contain transition-transform duration-300 hover:scale-105"
									loading="lazy"
								/>
							</div>
							<div class="p-4 sm:p-6 flex flex-col grow">
								<h3 class="text-lg sm:text-xl font-semibold mb-2 uppercase">
									{model.name}
								</h3>
								<div class="mt-auto pt-4">
									<Button
										view="link"
										classes="btn w-full"
										url={`/models/${model.id}/`}
										title="Подробнее"
									/>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		)}

		<div>
			<h2 class="text-2xl sm:text-3xl mb-6 sm:mb-8">Преимущества для корпоративных клиентов</h2>
			<ul class="space-y-4 sm:space-y-5">
				<li class="flex items-start gap-3 sm:gap-4">
					<Icon name="mdi:car-multiple" class="text-accent-500 shrink-0 text-2xl sm:text-3xl mt-0.5" />
					<span class="text-base sm:text-lg text-gray-700">Широкий модельный ряд: 12 моделей. От компактного седана до вместительного кроссовера</span>
				</li>
				<li class="flex items-start gap-3 sm:gap-4">
					<Icon name="mdi:car-select" class="text-accent-500 shrink-0 text-2xl sm:text-3xl mt-0.5" />
					<span class="text-base sm:text-lg text-gray-700">Большой выбор автомобилей в наличии</span>
				</li>
				<li class="flex items-start gap-3 sm:gap-4">
					<Icon name="mdi:tag-multiple" class="text-accent-500 shrink-0 text-2xl sm:text-3xl mt-0.5" />
					<span class="text-base sm:text-lg text-gray-700">Гибкая система скидок и привилегий</span>
				</li>
				<li class="flex items-start gap-3 sm:gap-4">
					<Icon name="mdi:handshake" class="text-accent-500 shrink-0 text-2xl sm:text-3xl mt-0.5" />
					<span class="text-base sm:text-lg text-gray-700">Согласование индивидуальной партии автомобилей под Ваш запрос</span>
				</li>
				<li class="flex items-start gap-3 sm:gap-4">
					<Icon name="mdi:truck-delivery" class="text-accent-500 shrink-0 text-2xl sm:text-3xl mt-0.5" />
					<span class="text-base sm:text-lg text-gray-700">Региональная доставка</span>
				</li>
				<li class="flex items-start gap-3 sm:gap-4">
					<Icon name="mdi:credit-card-multiple" class="text-accent-500 shrink-0 text-2xl sm:text-3xl mt-0.5" />
					<span class="text-base sm:text-lg text-gray-700">Специальные условия при приобретении в лизинг</span>
				</li>
				<li class="flex items-start gap-3 sm:gap-4">
					<Icon name="mdi:wrench" class="text-accent-500 shrink-0 text-2xl sm:text-3xl mt-0.5" />
					<span class="text-base sm:text-lg text-gray-700">Поддержка сервиса</span>
				</li>
			</ul>
		</div>
	</div>
</Layout>